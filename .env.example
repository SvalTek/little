# Optional root of a GCC toolchain. On Windows, use an MSYS2 UCRT64 root
# with mingw-w64-ucrt-x86_64-gcc, make, and openssl installed; the scripts use
# GCC_PATH/bin/gcc.exe (and g++.exe for the optional WebUI native library).
# OpenSSL headers, libraries, and runtime DLLs must match this toolchain.
GCC_PATH=

# Optional additional C include directory. Leave this blank unless your
# toolchain or local dependencies need headers outside their normal search path.
INCLUDES_PATH=
