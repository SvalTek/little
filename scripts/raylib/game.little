; A small arcade game built only with the raylib native library, the way a
; LÖVE-level project would be: states, input, sprites, collision, particles,
; screen shake, HUD, and a saved high score.
;
; Build first:
;   task build:nativelibs
;
; Then run:
;   build/little.exe scripts/raylib/game.little
;
; Set LITTLE_GAME_AUTOPLAY=1 to let it play itself (used by the smoke test).

var ray = loadLibrary("nativelib/raylib/build/raylib")

ray.traceLog(ray.log.none)

var WIDTH = 640
var HEIGHT = 360
var SCORE_PATH = "build/raylib-game-score.txt"
var AUTOPLAY_PATH = "build/raylib-game-autoplay"

; The stdlib has no string-to-number conversion and no byte access, so a saved
; score cannot be read back as a number: the high score only survives in memory
; for this session, and the file is written for a future version that can parse.
var AUTOPLAY = pcall(fn() { return io.readFile(AUTOPLAY_PATH) }).ok

; ---------------------------------------------------------------- assets

; The window has to exist before any GPU resource is created, so assets load
; after open() rather than at the top of the file.
ray.open(WIDTH, HEIGHT, "SWARM")

; Sprites are generated as flat colours: the library can load images but has no
; way to draw into one, so a game with art has to ship image files.
var sprites = {
    player: ray.loadTextureFromImage(ray.genImageColor(12, 12, ray.Color(120, 220, 255))),
    enemy: ray.loadTextureFromImage(ray.genImageColor(10, 10, ray.Color(230, 90, 90))),
    bullet: ray.loadTextureFromImage(ray.genImageColor(4, 4, ray.Color(255, 240, 160))),
    particle: ray.loadTextureFromImage(ray.genImageColor(3, 3, ray.Color(255, 200, 120)))
}
var font = ray.defaultFont()

; ---------------------------------------------------------------- helpers

var distance = fn(a, b) {
    var dx = a.x - b.x
    var dy = a.y - b.y
    return math.sqrt(dx * dx + dy * dy)
}

var loadHighScore = fn() {
    ; See the note above: reading a number back is not possible yet.
    return 0
}

var saveHighScore = fn(score) {
    if score > highScore {
        highScore = score
        pcall(fn() { io.writeFile(SCORE_PATH, string.from(score)) })
    }
}

; ---------------------------------------------------------------- state

var state = "title"
var highScore = loadHighScore()
var score = 0
var lives = 3
var shake = 0.0
var spawnTimer = 0.0
var elapsed = 0.0
var player = { x: WIDTH / 2, y: HEIGHT / 2, speed: 190.0, cooldown: 0.0 }
var bullets = []
var enemies = []
var particles = []

var reset = fn() {
    state = "playing"
    score = 0
    lives = 3
    shake = 0.0
    spawnTimer = 0.0
    elapsed = 0.0
    player.x = WIDTH / 2
    player.y = HEIGHT / 2
    player.cooldown = 0.0
    bullets = []
    enemies = []
    particles = []
}

; ---------------------------------------------------------------- input

; Autoplay drives the same table the keyboard would, so the game logic is
; exercised without a display.
var readInput = fn() {
    var input = { up: false, down: false, left: false, right: false, fire: false }
    if AUTOPLAY {
        if array.len(enemies) > 0 {
            var target = enemies[0]
            input.right = target.x > player.x + 4
            input.left = target.x < player.x - 4
            input.down = target.y > player.y + 4
            input.up = target.y < player.y - 4
        }
        input.fire = array.len(enemies) > 0
        return input
    }
    input.up = ray.keyDown(ray.keys.w) or ray.keyDown(ray.keys.up)
    input.down = ray.keyDown(ray.keys.s) or ray.keyDown(ray.keys.down)
    input.left = ray.keyDown(ray.keys.a) or ray.keyDown(ray.keys.left)
    input.right = ray.keyDown(ray.keys.d) or ray.keyDown(ray.keys.right)
    input.fire = ray.mouseDown(ray.mouseButtons.left) or ray.keyDown(ray.keys.space)
    return input
}

; ---------------------------------------------------------------- simulation

var spawnEnemy = fn() {
    var edge = math.randomInt(0, 3)
    var x = 0.0
    var y = 0.0
    if edge is 0 {
        x = math.random() * WIDTH
        y = -12.0
    }
    elseif edge is 1 {
        x = WIDTH + 12.0
        y = math.random() * HEIGHT
    }
    elseif edge is 2 {
        x = math.random() * WIDTH
        y = HEIGHT + 12.0
    }
    else {
        x = -12.0
        y = math.random() * HEIGHT
    }
    array.push(enemies, { x: x, y: y, speed: 55.0 + elapsed * 1.6 })
}

var burst = fn(x, y, count) {
    var index = 0
    while index < count {
        var angle = math.random() * math.pi * 2
        var speed = 30.0 + math.random() * 90.0
        array.push(particles, {
            x: x, y: y,
            vx: math.cos(angle) * speed,
            vy: math.sin(angle) * speed,
            life: 0.35 + math.random() * 0.35
        })
        index = index + 1
    }
}

var updatePlaying = fn(dt) {
    elapsed = elapsed + dt
    var input = readInput()

    if input.up { player.y = player.y - player.speed * dt }
    if input.down { player.y = player.y + player.speed * dt }
    if input.left { player.x = player.x - player.speed * dt }
    if input.right { player.x = player.x + player.speed * dt }
    player.x = math.clamp(player.x, 6, WIDTH - 6)
    player.y = math.clamp(player.y, 6, HEIGHT - 6)

    player.cooldown = player.cooldown - dt
    if input.fire and player.cooldown <= 0 {
        player.cooldown = 0.14
        var aimX = 0.0
        var aimY = -1.0
        var nearest = 999999.0
        var aimIndex = 0
        while aimIndex < array.len(enemies) {
            var candidate = enemies[aimIndex]
            var reach = distance(candidate, player)
            if reach < nearest {
                nearest = reach
                aimX = candidate.x - player.x
                aimY = candidate.y - player.y
            }
            aimIndex = aimIndex + 1
        }
        var aimLength = math.sqrt(aimX * aimX + aimY * aimY)
        if aimLength < 0.001 {
            aimX = 0.0
            aimY = -1.0
            aimLength = 1.0
        }
        array.push(bullets, { x: player.x, y: player.y, vx: aimX / aimLength * 320.0, vy: aimY / aimLength * 320.0 })
    }

    spawnTimer = spawnTimer - dt
    if spawnTimer <= 0 {
        spawnTimer = math.max(0.25, 0.95 - elapsed * 0.02)
        spawnEnemy()
    }

    var kept = []
    var index = 0
    while index < array.len(bullets) {
        var bullet = bullets[index]
        bullet.x = bullet.x + bullet.vx * dt
        bullet.y = bullet.y + bullet.vy * dt
        if bullet.y > -8 and bullet.y < HEIGHT + 8 and bullet.x > -8 and bullet.x < WIDTH + 8 {
            array.push(kept, bullet)
        }
        index = index + 1
    }
    bullets = kept

    var alive = []
    index = 0
    while index < array.len(enemies) {
        var enemy = enemies[index]
        var dx = player.x - enemy.x
        var dy = player.y - enemy.y
        var length = math.sqrt(dx * dx + dy * dy)
        if length > 0.001 {
            enemy.x = enemy.x + dx / length * enemy.speed * dt
            enemy.y = enemy.y + dy / length * enemy.speed * dt
        }
        if distance(enemy, player) < 11 {
            lives = lives - 1
            shake = 12.0
            burst(enemy.x, enemy.y, 14)
            saveHighScore(score)
            if lives <= 0 { state = "gameover" }
        }
        else {
            array.push(alive, enemy)
        }
        index = index + 1
    }
    enemies = alive

    kept = []
    index = 0
    while index < array.len(enemies) {
        var enemy = enemies[index]
        var hit = false
        var bulletIndex = 0
        while bulletIndex < array.len(bullets) and not hit {
            if distance(bullets[bulletIndex], enemy) < 9 {
                hit = true
                score = score + 10
                shake = 5.0
                burst(enemy.x, enemy.y, 10)
                array.remove(bullets, bulletIndex)
            }
            bulletIndex = bulletIndex + 1
        }
        if not hit { array.push(kept, enemy) }
        index = index + 1
    }
    enemies = kept

    var living = []
    index = 0
    while index < array.len(particles) {
        var particle = particles[index]
        particle.x = particle.x + particle.vx * dt
        particle.y = particle.y + particle.vy * dt
        particle.life = particle.life - dt
        if particle.life > 0 { array.push(living, particle) }
        index = index + 1
    }
    particles = living

    shake = math.max(0, shake - dt * 40.0)
}

; ---------------------------------------------------------------- drawing

var drawPlaying = fn() {
    var offsetX = 0.0
    var offsetY = 0.0
    if shake > 0 {
        offsetX = (math.random() - 0.5) * shake
        offsetY = (math.random() - 0.5) * shake
    }

    ray.clear(ray.Color(18, 18, 26))

    var index = 0
    while index < array.len(particles) {
        var particle = particles[index]
        ray.rect(particle.x + offsetX, particle.y + offsetY, 3, 3, ray.colors.orange)
        index = index + 1
    }

    index = 0
    while index < array.len(bullets) {
        var bullet = bullets[index]
        sprites.bullet:draw(bullet.x + offsetX - 2, bullet.y + offsetY - 2, ray.colors.white)
        index = index + 1
    }

    index = 0
    while index < array.len(enemies) {
        var enemy = enemies[index]
        sprites.enemy:draw(enemy.x + offsetX - 5, enemy.y + offsetY - 5, ray.colors.white)
        index = index + 1
    }

    sprites.player:draw(player.x + offsetX - 6, player.y + offsetY - 6, ray.colors.white)

    ray.text(string.concat("score ", string.from(score)), 8, 6, 14, ray.colors.white)
    ray.text(string.concat("best ", string.from(highScore)), 8, 24, 12, ray.colors.gray)
    ray.textCentered(string.repeat("|", lives), 6, 14, ray.colors.red)
    ray.drawFPS(8, HEIGHT - 20)
}

var drawTitle = fn() {
    ray.clear(ray.Color(18, 18, 26))
    ray.textCentered("SWARM", HEIGHT / 2 - 50, 40, ray.colors.skyblue)
    ray.textCentered("WASD to move, click or space to fire", HEIGHT / 2 + 6, 14, ray.colors.gray)
    ray.textCentered(string.concat("best ", string.from(highScore)), HEIGHT / 2 + 26, 14, ray.colors.gold)
    ray.textCentered("press space to start", HEIGHT / 2 + 56, 14, ray.colors.white)
}

var drawPaused = fn() {
    ray.textCentered("PAUSED", HEIGHT / 2 - 20, 30, ray.colors.white)
    ray.textCentered("press P to resume", HEIGHT / 2 + 20, 14, ray.colors.gray)
}

var drawGameOver = fn() {
    ray.textCentered("GAME OVER", HEIGHT / 2 - 40, 32, ray.colors.red)
    ray.textCentered(string.concat("score ", string.from(score)), HEIGHT / 2 + 4, 18, ray.colors.white)
    ray.textCentered(string.concat("best ", string.from(highScore)), HEIGHT / 2 + 28, 14, ray.colors.gold)
    ray.textCentered("press space to play again", HEIGHT / 2 + 56, 14, ray.colors.white)
}

; ---------------------------------------------------------------- loop

var frames = 0
var sawPlaying = false
var sawEnemy = false

ray.on("start", fn() {
    ray.setFPS(60)
    if AUTOPLAY {
        reset()
    }
})

ray.on("update", fn(dt) {
    frames = frames + 1
    ; A real game clamps dt: the first frame and window drags produce spikes.
    var step = math.min(dt, 0.05)

    if state is "playing" {
        sawPlaying = true
        if array.len(enemies) > 0 { sawEnemy = true }
        updatePlaying(step)
        drawPlaying()
    }
    elseif state is "paused" {
        drawPlaying()
        drawPaused()
    }
    elseif state is "gameover" {
        drawPlaying()
        drawGameOver()
    }
    else {
        drawTitle()
    }

    if AUTOPLAY {
        if state is "playing" and elapsed > 3.0 {
            state = "gameover"
            saveHighScore(score)
        }
        if frames > 260 {
            ray.close()
        }
        return null
    }

    if state is "title" and ray.keyPressed(ray.keys.space) {
        reset()
    }
    elseif state is "playing" {
        if ray.keyPressed(ray.keys.p) { state = "paused" }
    }
    elseif state is "paused" {
        if ray.keyPressed(ray.keys.p) { state = "playing" }
    }
    elseif state is "gameover" {
        if ray.keyPressed(ray.keys.space) { reset() }
    }

    if ray.keyPressed(ray.keys.escape) {
        ray.close()
    }
})

while ray.update() {
}

sprites.player:unload()
sprites.enemy:unload()
sprites.bullet:unload()
sprites.particle:unload()
ray.close()

if AUTOPLAY {
    io.print(string.concat("frames ", string.from(frames)))
    io.print(string.concat("played ", string.from(sawPlaying)))
    io.print(string.concat("spawned ", string.from(sawEnemy)))
    io.print(string.concat("score ", string.from(score)))
    io.print(string.concat("state ", state))
}
