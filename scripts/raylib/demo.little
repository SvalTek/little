; Raylib native-library demo. Needs a display; not run by scripts/run.ps1.
;
; Build first:
;   task build:nativelibs
;
; Then run:
;   build/little.exe scripts/raylib/demo.little

var ray = loadLibrary("nativelib/raylib/build/raylib")

ray.open(800, 450, "little + raylib")

var background = ray.Color(20, 20, 30)
var accent = ray.Color(255, 100, 50)
var label = ray.Vector2(10, 60)
var body = ray.Rectangle(10, 200, 120, 40)
var x = 10.0

ray.on("start", fn() {
    ray.setFPS(60)
    io.print("raylib " + ray.version)
})

ray.on("update", fn(dt) {
    x = x + 120.0 * dt
    if x > 680.0 {
        x = 10.0
    }
    body.x = x
    ray.clear(background)
    ray.rect(body, accent)
    ray.text("little + raylib", label, 20, ray.colors.white)
    if ray.keyPressed(ray.keys.escape) {
        ray.close()
    }
})

while ray.update() {
}

ray.close()
