io.print("stdlib collections")

var words = string.split(" red, green, blue ", ",")
words[0] = string.trim(words[0])
words[1] = string.trim(words[1])
words[2] = string.trim(words[2])

array.insert(words, 1, "gold")
array.push(words, "violet")

io.print(array.join(words, " | "))
io.print("first", array.first(words), "last", array.last(words))
io.print("contains-green", array.contains(words, "green"))

var reversed = array.reverse(words)
io.print(array.join(reversed, ","))

var swatch = { primary: "red" accent: "gold" }
table.put(swatch, "count", array.len(words))
io.print(string.expand("palette {{primary}}/{{accent}} has {{count}} colors", swatch))
io.print("has-accent", table.has(swatch, "accent"))
io.print("fallback", table.fetch(swatch, "missing", "none"))
