io.print("language basics")

var describe = fn(value) {
    if value > 10 {
        return "large"
    }
    elseif value is 10 {
        return "ten"
    }
    else {
        return "small"
    }
}

var numbers = [ 1, 2, 3, 4 ]
var total = 0

for n in array.each(numbers) {
    total = total + n
}

var profile = { name: "Ada" score: total }
profile.status = describe(profile.score)

io.print("sum", total, profile.status)
io.print(string.expand("{{name}} scored {{score}} which is {{status}}", profile))

var countdown = 3
while countdown > 0 {
    io.print("countdown", countdown)
    countdown = countdown - 1
}
