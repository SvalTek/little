; number covers the number type: coercion, formatting, predicates, ranges, and
; limits. Arithmetic lives in math, and the two do not overlap.

io.print(number.from("42"))
io.print(number.from("  3.5  "))
io.print(number.from("+7"))
io.print(number.from("-2.5"))
io.print(number.from("1e3"))
io.print(number.from("0xFF"))
io.print(number.from("0b1010"))
io.print(number.from("-0x10"))
io.print(number.from(7))
io.print(number.from("abc") is null)
io.print(number.from("42x") is null)
io.print(number.from("") is null)
io.print(number.from("   ") is null)
io.print(number.from(true) is null)
io.print(number.from(null) is null)
io.print(number.from([ 1 ]) is null)

; string.from is the plain coercion, number.format is the precision-controlled
; one, and toBase renders in a base that number.from can read back.
io.print(string.from(42))
io.print(number.format(3.14159, 2))
io.print(number.format(42, 0))
io.print(number.format(1234567, 0, true))
io.print(number.format(-1234.5, 2, true))
io.print(number.toBase(255, 16, true))
io.print(number.toBase(10, 2, true))
io.print(number.toBase(-255, 16))
io.print(number.from(number.toBase(255, 16, true)))
io.print(number.from(number.toBase(10, 2, true)))
io.print(number.from(string.from(3.5)))

io.print(number.isInteger(3))
io.print(number.isInteger(3.5))
io.print(number.isSafeInteger(9007199254740991))
io.print(number.isSafeInteger(9007199254740992))
io.print(number.isClose(0.1 + 0.2, 0.3))
io.print(number.isClose(1, 2))
io.print(number.isClose(1, 1.0000000001, 1e-3))

; trunc is not floor: it goes towards zero.
io.print(number.trunc(-1.5))
io.print(math.floor(-1.5))
io.print(number.roundTo(3.14159, 2))
io.print(number.snap(17, 5))
io.print(number.wrap(-1, 0, 10))
io.print(number.wrap(12, 0, 10))
io.print(number.pingPong(12, 10))
io.print(number.pingPong(3, 10))
io.print(number.map(5, 0, 10, 0, 100))

io.print(number.infinity > 1000000)
io.print(number.epsilon > 0)
io.print(number.maxSafeInteger)
io.print(number.minSafeInteger)

; NaN cannot be stored in the boxed value representation, so it is rejected
; rather than returned - including strtod's implementation-defined payloads,
; whose bits can look like a value tag. Infinity round-trips, so it is kept.
io.print(number.from("nan") is null)
io.print(number.from("nan(0x5000000000001)") is null)
io.print(number.from("inf"))
io.print(number.from("-inf"))

; An infinite operand is never close to a finite one, and the scaled tolerance
; would otherwise make INFINITY <= INFINITY succeed.
io.print(number.isClose(number.infinity, 1))
io.print(number.isClose(number.infinity, 0 - number.infinity))
io.print(number.isClose(number.infinity, number.infinity))

; Bases and decimal places are whole numbers: a fractional value would be
; silently truncated by the cast, changing its meaning.
var fractionalBase = pcall(fn() { return number.toBase(10, 2.5) })
io.print(fractionalBase.ok)
var fractionalDecimals = pcall(fn() { return number.format(1.5, 2.5) })
io.print(fractionalDecimals.ok)
var fractionalRound = pcall(fn() { return number.roundTo(1.23456, 1.5) })
io.print(fractionalRound.ok)

; An infinite input has no meaningful wrap, and fmod would leak a NaN into the
; value representation, so the arguments must be finite.
var infiniteWrap = pcall(fn() { return number.wrap(number.infinity, 0, 10) })
io.print(infiniteWrap.ok)
var infinitePingPong = pcall(fn() { return number.pingPong(number.infinity, 10) })
io.print(infinitePingPong.ok)

; snap and map can produce a NaN the same way - infinity over infinity - so
; they require finite arguments too.
var infiniteSnap = pcall(fn() { return number.snap(5, number.infinity) })
io.print(infiniteSnap.ok)
var infiniteMap = pcall(fn() { return number.map(number.infinity, 0, number.infinity, 0, 100) })
io.print(infiniteMap.ok)

; Extreme but representable cases compute the right answer rather than raising:
; the helpers work in halved units so an unrepresentable intermediate cannot
; reject a call whose answer is finite. The halving costs a unit in the last
; place, so these compare with a tolerance.
io.print(number.isClose(number.snap(1e300, 1e-300), 1e300))
io.print(number.isClose(number.wrap(1e308, 0 - 1e308, 1e308), 0 - 1e308))
io.print(number.isClose(number.pingPong(1.7e308, 9e307), 1e307))
io.print(number.isClose(number.map(1e308, 0 - 1e308, 1e308, 0, 100), 100))

; A result that genuinely cannot be represented is still an error.
var unrepresentable = pcall(fn() { return number.map(1e308, 0, 1, 0, 1e308) })
io.print(unrepresentable.ok)
io.print(number.snap(17, 5))
io.print(number.map(5, 0, 10, 0, 100))

; Scaling before rounding can overflow for a very large value, which has no
; fractional part at that precision, so the result stays finite.
io.print(number.roundTo(1e308, 2) > 1e307)
