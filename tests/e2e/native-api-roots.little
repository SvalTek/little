var roots = loadLibrary("tests/native/rooting")

; The host advertises table members appended after the previous api release.
var members = roots.apiMembers()
io.print(members.sizeOk)
io.print(members.hasRoot)
io.print(members.hasUnroot)
io.print(members.hasEquals)
io.print(members.hasPersistentRoot)
io.print(members.hasPersistentUnroot)

; Object and string values rooted from C locals survive re-entrant collection.
var [marker, localString] = roots.rootedHold()
io.print(marker)
io.print(localString)

; Persistent roots survive the native callback that creates them and can be
; released explicitly after the script drops its reference.
roots.persistentHold(fn() { return "PERSISTENT ALIVE" })
gc.collect()
io.print(roots.persistentCall())
roots.persistentHold(fn() { return "REPLACED CALLBACK" })
gc.collect()
io.print(roots.persistentCall())
roots.persistentClear()

; The positive collection count proves the unrooted table was collected;
; the fixture never reads through its dangling C-local pointer.
io.print(roots.unrootedCollected() > 0)

; Native libraries can compare values without linking against the host.
io.print(roots.equals("Ada", "Ada"))
io.print(roots.equals("Ada", "Bob"))
io.print(roots.equals(2, 2))
io.print(roots.equals(2, 3))
io.print(roots.equals(null, null))
io.print(roots.equals(null, false))
io.print(roots.equals() is null)

; Error traps that invoke the VM directly must restore native root scopes too.
var failed = pcall(roots.rootAndFail)
io.print(not failed.ok)
io.print(roots.rootCount() is 0)

; Import has its own error trap around module execution.
var importFailed = pcall(fn() {
    return import "tests/fixtures/native-root-error"
})
io.print(not importFailed.ok)
io.print(roots.rootCount() is 0)
