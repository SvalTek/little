io.print(math.clamp(12, 0, 10))
io.print(math.clamp(-2, 0, 10))
io.print(math.lerp(10, 20, 0.25))
io.print(math.sign(-5), math.sign(0), math.sign(5))
io.print(math.deg(math.pi))
io.print(math.round(math.rad(180) * 1000))
io.print(math.isfinite(1))
io.print(math.isnan(1))
math.seed(1)
var r = math.random()
io.print(r >= 0 and r < 1)
var i = math.randomInt(3, 5)
io.print(i >= 3 and i <= 5)
